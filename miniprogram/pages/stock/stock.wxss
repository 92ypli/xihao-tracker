.name {
  font-size: 36rpx;
  font-weight: 600;
}

.code {
  font-size: 24rpx;
  margin-left: 14rpx;
}

.badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  color: #0f172a;
}

.badge.buy { background: #ef4444; }
.badge.hold { background: #64748b; color: #f1f5f9; }
.badge.trim { background: #22c55e; }
.badge.na { background: #334155; color: #94a3b8; }

.baseline { align-items: baseline; margin-top: 16rpx; gap: 18rpx; }
.big { font-size: 56rpx; font-weight: 700; }

.metrics {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
  border-top: 1rpx solid #334155;
  padding-top: 18rpx;
}

.metric { width: 33.33%; margin-bottom: 14rpx; }
.metric .k { display: block; font-size: 22rpx; color: #94a3b8; }
.metric .v { display: block; font-size: 28rpx; margin-top: 4rpx; }

.small { font-size: 24rpx; }
.mt { margin-top: 14rpx; }

.bands { display: flex; gap: 20rpx; }

.band {
  flex: 1;
  border-radius: 14rpx;
  padding: 20rpx;
  background: #0f172a;
  border-left: 6rpx solid #64748b;
}

.band.buy { border-left-color: #ef4444; }
.band.trim { border-left-color: #22c55e; }
.band-k { display: block; font-size: 22rpx; color: #94a3b8; }
.band-v { display: block; font-size: 44rpx; font-weight: 700; margin: 6rpx 0; }
.band.buy .band-v { color: #ef4444; }
.band.trim .band-v { color: #22c55e; }
.band-sub { display: block; font-size: 20rpx; color: #64748b; line-height: 1.5; }

.dist {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.bar {
  position: relative;
  display: flex;
  height: 20rpx;
  margin: 30rpx 0 10rpx;
}

.zone { height: 20rpx; }
.zone.buy { width: 30%; background: #ef4444; border-radius: 999rpx 0 0 999rpx; }
.zone.hold { width: 40%; background: #475569; }
.zone.trim { width: 30%; background: #22c55e; border-radius: 0 999rpx 999rpx 0; }

.cursor {
  position: absolute;
  top: -10rpx;
  width: 4rpx;
  height: 40rpx;
  background: #ffffff;
  border-radius: 2rpx;
}

.bar-legend {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
}

.doc {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #334155;
}

.doc:last-of-type { border-bottom: none; }
.doc-date { font-size: 22rpx; color: #94a3b8; }
.org { font-size: 22rpx; color: #38bdf8; }
.doc-title { display: block; font-size: 27rpx; line-height: 1.5; margin-top: 6rpx; }

.warn { border-left: 6rpx solid #fbbf24; }
.warn-item { font-size: 26rpx; line-height: 1.7; color: #fbbf24; }

.disclaimer {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #64748b;
  text-align: center;
  line-height: 1.6;
}
