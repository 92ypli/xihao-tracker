page {
  background: #0f172a;
  color: #e2e8f0;
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.page {
  padding: 24rpx 24rpx 60rpx;
}

.card {
  background: #1e293b;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  justify-content: space-between;
}

.muted {
  color: #94a3b8;
}

.up {
  color: #ef4444;
}

.down {
  color: #22c55e;
}

.flat {
  color: #94a3b8;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 8rpx 0 20rpx;
}

.center {
  text-align: center;
}
